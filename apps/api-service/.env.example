DATABASE_URL=postgres://user:pass@localhost:5432/midtone
# Go auth-service base URL. JWTs are verified against its JWKS
# ($AUTH_SERVICE_URL/api/auth/jwks). Used by apps/web-beta.
AUTH_SERVICE_URL=http://localhost:3100
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# apps/embed-service (potion-base-8M, 256-dim) — powers relevance-sort
# embedding. Internal service, no auth.
EMBED_SERVICE_URL=http://localhost:4107
# Supabase Storage for uploads (e.g. onboarding logos). Bucket must be created as public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=catalogue
PORT=4002
# GeBIZ is hidden from every tender read (listing, filters, detail) by default,
# pending written DSTA permission. See apps/tender-worker/internal/gebiz/COMPLIANCE.md.
# Set to true to surface GeBIZ tenders again.
GEBIZ_LISTING_ENABLED=false
