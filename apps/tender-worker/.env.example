DATABASE_URL=postgres://user:pass@localhost:5432/midtone
# apps/ollama (all-minilm) — Ollama's hosted cloud API doesn't serve
# embedding models, only chat models, so this must point at a real Ollama
# server. Unauthenticated (private network only), so no API key.
OLLAMA_EMBED_BASE_URL=http://localhost:11434
# GeBIZ RSS ingestion is ceased by default pending written DSTA permission.
# See internal/gebiz/COMPLIANCE.md. Set to true to resume ingesting GeBIZ.
GEBIZ_ENABLED=false
