# API gateway base URL (APISIX). All API calls — and the Connect Four WebSocket
# at /ws — go through this gateway; the WS URL is derived from it
# (http(s):// -> ws(s)://), so no separate WebSocket env var is needed.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Public site URL, used for canonical URLs, sitemap and robots. Prod only;
# defaults to https://tenderlah.sg when unset.
# NEXT_PUBLIC_SITE_URL=https://tenderlah.sg

# GeBIZ deep-linking requires prior written permission from DSTA. Leave false
# until permission is on file; when true, GeBIZ tender pages show the outbound
# "Open source page" link. See apps/tender-worker/internal/gebiz/COMPLIANCE.md.
NEXT_PUBLIC_GEBIZ_LINKS_ENABLED=false
